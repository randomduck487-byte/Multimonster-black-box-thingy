-- ⚡ 3. STRICT 45-STUD SPATIAL SCANNER
---------------------------------------------------------
local activeScanner = task.spawn(function()
    while true do
        pcall(function()
            trackedTargetParts = {}
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("BasePart") and isTargetPart(desc) then
                    table.insert(trackedTargetParts, desc)
                end
            end

            if #trackedTargetParts > 0 then
                for _, targetPart in ipairs(trackedTargetParts) do
                    if targetPart and targetPart.Parent then
                        local partsInRadius = Workspace:GetPartBoundsInRadius(targetPart.Position, 45)
                        for _, part in ipairs(partsInRadius) do
                            if part:IsA("BasePart") and not corruptedObjects[part] then
                                corruptObject(part, targetPart.Position)
                            end
                        end
                    end
                end
            end
        end)
        task.wait(0.2)
    end
end)

