-- hyper-optimized particle redaction script (1-second tick edition)
local p = game:GetService("Players").LocalPlayer
local ws = game:GetService("Workspace")

-- 1. strict cleanup of old scripts
local g = getgenv and getgenv() or _G
if g.r_conns then
    for _, c in pairs(g.r_conns) do pcall(function() c:Disconnect() end) end
end
g.r_conns = {}
g.r_active = false
task.wait(0.1)
g.r_active = true

local function track(sig, fn)
    local c = sig:Connect(fn)
    table.insert(g.r_conns, c)
    return c
end

-- cleanup old guis & particles
local pgui = p:WaitForChild("PlayerGui")
for _, v in ipairs(pgui:GetChildren()) do
    if v.Name:find("RedactGui") or v.Name:find("FaceRedaction") then v:Destroy() end
end
for _, v in ipairs(ws:GetDescendants()) do
    if v:IsA("ParticleEmitter") and v.Name == "GlitchRedact" then v:Destroy() end
end

-- 2. tracking by MODEL
local trackedModels = {}

local function applyParticle(part)
    part.Color = Color3.new(0, 0, 0)
    part.Material = Enum.Material.SmoothPlastic
    
    local emit = Instance.new("ParticleEmitter")
    emit.Name = "GlitchRedact"
    emit.Texture = "rbxassetid://1214227376"
    emit.Color = ColorSequence.new(Color3.new(0, 0, 0))
    emit.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 6),
        NumberSequenceKeypoint.new(1, 0)
    })
    emit.Transparency = NumberSequence.new(0.1)
    emit.Lifetime = NumberRange.new(0.3, 0.5)
    emit.Rate = 35
    emit.Speed = NumberRange.new(1, 4)
    emit.SpreadAngle = Vector2.new(360, 360)
    emit.LockedToPart = true
    emit.ZOffset = 2
    emit.Enabled = false
    emit.Parent = part
    
    return emit
end

local function scanModel(model)
    if model:IsA("Model") and model.Name:lower():find("multi") then
        if trackedModels[model] then return end
        
        local emitters = {}
        local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
        
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("BasePart") then
                table.insert(emitters, applyParticle(v))
                if not rootPart then rootPart = v end
            end
        end
        
        if rootPart then
            trackedModels[model] = { root = rootPart, emitters = emitters }
            
            track(model.DescendantAdded, function(v)
                if v:IsA("BasePart") then
                    table.insert(trackedModels[model].emitters, applyParticle(v))
                end
            end)
            
            track(model.AncestryChanged, function(_, parent)
                if not parent then trackedModels[model] = nil end
            end)
        end
    end
end

local function checkChild(child)
    if child:IsA("Model") then
        if child.Name:lower():find("multi") then
            scanModel(child)
        else
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Model") then scanModel(sub) end
            end
        end
    end
end

for _, v in ipairs(ws:GetChildren()) do checkChild(v) end
track(ws.ChildAdded, checkChild)

local rooms = ws:FindFirstChild("CurrentRooms")
if rooms then
    for _, room in ipairs(rooms:GetChildren()) do
        for _, child in ipairs(room:GetChildren()) do checkChild(child) end
        track(room.ChildAdded, checkChild)
    end
    track(rooms.ChildAdded, function(room)
        for _, child in ipairs(room:GetChildren()) do checkChild(child) end
        track(room.ChildAdded, checkChild)
    end)
end

-- 3. background loop throttled to exactly 1 second
local ray = RaycastParams.new()
ray.FilterType = Enum.RaycastFilterType.Exclude

task.spawn(function()
    while g.r_active do
        task.wait(1.0)
        
        local char = p.Character
        local pRoot = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        
        if pRoot then
            for model, data in pairs(trackedModels) do
                if model.Parent and data.root and data.root.Parent then
                    local dist = (data.root.Position - pRoot.Position).Magnitude
                    local visible = false
                    
                    if dist < 250 then
                        ray.FilterDescendantsInstances = {model, char}
                        local hit = ws:Raycast(data.root.Position, pRoot.Position - data.root.Position, ray)
                        visible = (hit == nil)
                    end
                    
                    for _, emit in ipairs(data.emitters) do
                        if emit.Parent then emit.Enabled = visible end
                    end
                else
                    trackedModels[model] = nil
                end
            end
        end
    end
end)
nGlitchEffect(cachedBestScreenPoint, cachedMainSize)
end
else
mainSquare.Visible = false
for i = 1, RAPID_COUNT do rapidSquares[i].frame.Visible = false end
end

if cachedCanSeePlayer then
setBodyRedacted(true, playerChar)

if (camera.CFrame.Position - playerHrp.Position).Magnitude > 4 then
local charScreenPoint, charOnScreen = camera:WorldToViewportPoint(playerHrp.Position)
if charOnScreen then
activeBoxesCount = activeBoxesCount + 1
local charDist = (camera.CFrame.Position - playerHrp.Position).Magnitude

local playerWidth = math_clamp(4000 / charDist, 60, 400)
local playerHeight = math_clamp(9000 / charDist, 100, 750)

secondarySquare.Size = UDim2.new(0, playerWidth, 0, playerHeight)
secondarySquare.Position = UDim2.new(0, charScreenPoint.X - (playerWidth / 2), 0, charScreenPoint.Y - (playerHeight / 2))
secondarySquare.Visible = true
else
secondarySquare.Visible = false
end
else
secondarySquare.Visible = false
end
else
setBodyRedacted(false, playerChar)
secondarySquare.Visible = false
end

if activeBoxesCount == 0 then
for i = 1, RAPID_COUNT do rapidSquares[i].frame.Visible = false end
end
end)
