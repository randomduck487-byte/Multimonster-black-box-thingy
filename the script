---------------------------------------------------------
-- 🌀 2. WALL/FLOOR IMMUNITY & 50% CORRUPTION LOGIC
---------------------------------------------------------
local trackedTargetParts = {}
local corruptedObjects = {}
local activeAssetBoxes = {}

local function isTargetPart(part)
    if TARGET_NAME == "" then
        return part:IsA("BasePart") and part.Anchored and not part.Parent:IsA("Terrain")
    end

    local searchKey = TARGET_NAME:lower()
    if part.Name:lower():find(searchKey) then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model.Name:lower():find(searchKey) then return true end
    return false
end

local function isWallFloorOrTerrain(part)
    local name = part.Name:lower()
    if name:find("floor") or name:find("ground") or name:find("baseplate") or name:find("terrain") or name:find("wall") then
        return true
    end
    if part.Parent and part.Parent:IsA("Terrain") then return true end
    if part.Size.Y < 3 and (part.Size.X > 30 or part.Size.Z > 30) then return true end
    if (part.Size.X < 3 or part.Size.Z < 3) and part.Size.Y > 20 then return true end
    return false
end

local function isVisibleFromCamera(targetPos, ignorePart)
    local camPos = camera.CFrame.Position
    local direction = (targetPos - camPos)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {}
    if player.Character then table.insert(ignoreList, player.Character) end
    if ignorePart then table.insert(ignoreList, ignorePart) end
    
    raycastParams.FilterDescendantsInstances = ignoreList

    local result = Workspace:Raycast(camPos, direction, raycastParams)
    
    if result then
        if ignorePart and result.Instance:IsDescendantOf(ignorePart) then
            return true
        end
        return (result.Position - targetPos).Magnitude < 3
    end
    return true
end

local function corruptObject(part, multiPos)
    if corruptedObjects[part] or not part:IsA("BasePart") or not part.Anchored then return end
    
    if isTargetPart(part) then return end
    if player.Character and part:IsDescendantOf(player.Character) then return end
    if isWallFloorOrTerrain(part) then return end

    corruptedObjects[part] = true

    pcall(function()
        -- 🎲 EXACT 50% CHANCE TO CORRUPT THE OBJECT
        if math.random() <= 0.5 then
            local mode = math.random(1, 3)
            local shouldRotate = (mode == 1 or mode == 2)
            local shouldAddCensor = (mode == 1 or mode == 3)

            -- 1. Proximity-scaled rotational distortion
            if shouldRotate then
                local dist = (part.Position - multiPos).Magnitude
                local intensity = 1 - (math.clamp(dist, 0, 45) / 45)
                
                local maxDeg = 5 + (intensity * 85)
                local rx = math.random(-maxDeg, maxDeg)
                local ry = math.random(-maxDeg, maxDeg)
                local rz = math.random(-maxDeg, maxDeg)
                
                part.CFrame = part.CFrame * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
            end

            -- 2. 2D Screen-space black censor box (1% to 100% random coverage)
            if shouldAddCensor then
                local coverage = math.random(1, 100) / 100
                local baseDimension = math.max(part.Size.X, part.Size.Y, part.Size.Z)

                local assetBox = Instance.new("Frame")
                assetBox.Name = "AssetDynamicScreenBox"
                assetBox.BackgroundColor3 = Color3.new(0, 0, 0)
                assetBox.BackgroundTransparency = 0
                assetBox.BorderSizePixel = 0
                assetBox.Visible = false
                assetBox.Parent = screenGui

                table.insert(activeAssetBoxes, {
                    part = part,
                    frame = assetBox,
                    baseSize = baseDimension * coverage
                })
            end
        end
    end)
end

