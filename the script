local trackedTargetParts = {}
local corruptedObjects = {}

local function isTargetPart(part)
    if TARGET_NAME == "" then
        return part:IsA("BasePart") and part.Anchored and not part.Parent:IsA("Terrain")
    end
    local searchKey = TARGET_NAME:lower()
    if part.Name:lower():find(searchKey) then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model.Name:lower():find(searchKey) then return true end
    return false
end

local function isWallFloorOrTerrain(part)
    local name = part.Name:lower()
    if name:find("floor") or name:find("ground") or name:find("baseplate") or name:find("terrain") or name:find("wall") then
        return true
    end
    if part.Parent and part.Parent:IsA("Terrain") then return true end
    return false
end

local function isVisibleFromCamera(targetPos, ignorePart)
    local camPos = camera.CFrame.Position
    local direction = (targetPos - camPos)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {}
    if player.Character then table_insert(ignoreList, player.Character) end
    if ignorePart then table_insert(ignoreList, ignorePart) end
    raycastParams.FilterDescendantsInstances = ignoreList

    local currentPos = camPos
    local remainingDir = direction
    
    for _ = 1, 5 do
        local result = Workspace:Raycast(currentPos, remainingDir, raycastParams)
        if not result then return true end
        local hitPart = result.Instance
        if hitPart then
            if ignorePart and hitPart:IsDescendantOf(ignorePart) then return true end
            
            if hitPart.Transparency >= 0.1 and hitPart.Transparency <= 1.0 then
                currentPos = result.Position + (remainingDir.Unit * 0.1)
                remainingDir = direction - (currentPos - camPos)
                table_insert(ignoreList, hitPart)
                raycastParams.FilterDescendantsInstances = ignoreList
            elseif hitPart.Transparency < 0.1 then
                return false
            else
                currentPos = result.Position + (remainingDir.Unit * 0.1)
                remainingDir = direction - (currentPos - camPos)
                table_insert(ignoreList, hitPart)
                raycastParams.FilterDescendantsInstances = ignoreList
            end
        else
            return true
        end
    end
    return true
end

local function isSoundCurrentlyPlaying(soundName)
    local playing = false
    pcall(function()
        local containers = {Workspace, SoundService, ReplicatedStorage}
        for _, container in ipairs(containers) do
            for _, desc in ipairs(container:GetDescendants()) do
                if desc:IsA("Sound") and desc.IsPlaying and desc.Name == soundName then
                    playing = true
                    break
                end
            end
            if playing then break end
        end
    end)
    return playing
end

local function isAnyAmbientPlaying()
    return isSoundCurrentlyPlaying("LordLord") or isSoundCurrentlyPlaying("KingOfGod") or isSoundCurrentlyPlaying("LaPeace")
end

