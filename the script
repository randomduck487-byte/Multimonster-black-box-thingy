local hasMetMultiBefore = false
local anyAmbientWasPlayingLast = false
local activeDialogueRoutine = nil

local function handleDialogueSystem()
    local anyAmbientPlaying = isAnyAmbientPlaying()

    if anyAmbientPlaying then
        if not anyAmbientWasPlayingLast then
            if activeDialogueRoutine then task.cancel(activeDialogueRoutine) end
            activeDialogueRoutine = task.spawn(function()
                if not hasMetMultiBefore then
                    hasMetMultiBefore = true
                    showDialogue("glad your paying attention", 3); task.wait(3.2)
                    showDialogue("you'll never learn", 3); task.wait(3.2)
                else
                    showDialogue("glad your paying attention", 3); task.wait(3.2)
                    showDialogue("don't fail this time", 3); task.wait(3.2)
                end
                while isAnyAmbientPlaying() do
                    showDialogue(DIALOGUE_POOL[math_random(1, #DIALOGUE_POOL)], 3)
                    task.wait(math_random(6, 10))
                end
                activeDialogueRoutine = nil
            end)
        elseif not activeDialogueRoutine then
            activeDialogueRoutine = task.spawn(function()
                while isAnyAmbientPlaying() do
                    showDialogue(DIALOGUE_POOL[math_random(1, #DIALOGUE_POOL)], 3)
                    task.wait(math_random(6, 10))
                end
                activeDialogueRoutine = nil
            end)
        end
    else
        if activeDialogueRoutine then task.cancel(activeDialogueRoutine); activeDialogueRoutine = nil end
        dialogueLabel.Visible = false
        dialogueLabel.Text = ""
    end

    anyAmbientWasPlayingLast = anyAmbientPlaying
end

local function corruptObjectsInRange(modeType)
    pcall(function()
        local char = player.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        local playerPos = root and root.Position or camera.CFrame.Position

        if modeType == "MultiProximity" then
            for _, multiPart in ipairs(trackedTargetParts) do
                if multiPart and multiPart.Parent then
                    local mPos = multiPart.Position
                    local mSize = multiPart.Size
                    -- Strictly bounded within 45 studs on every side around Multi's hitbox
                    local minBounds = mPos - (mSize / 2) - Vector3.new(45, 45, 45)
                    local maxBounds = mPos + (mSize / 2) + Vector3.new(45, 45, 45)

                    for _, p in ipairs(Workspace:GetDescendants()) do
                        if p:IsA("BasePart") and p.Anchored and not corruptedObjects[p] and not isTargetPart(p) and not isWallFloorOrTerrain(p) then
                            if not (char and p:IsDescendantOf(char)) then
                                local pPos = p.Position
                                if pPos.X >= minBounds.X and pPos.X <= maxBounds.X and
                                   pPos.Y >= minBounds.Y and pPos.Y <= maxBounds.Y and
                                   pPos.Z >= minBounds.Z and pPos.Z <= maxBounds.Z then
                                    
                                    -- Exactly 50% chance per object
                                    if math_random() <= 0.5 then
                                        corruptedObjects[p] = {cf = p.CFrame, box = nil}
                                        local outcome = (math_random() <= 0.5) and 1 or 2

                                        if outcome == 1 then
                                            local deg = 15
                                            p.CFrame = p.CFrame * CFrame.Angles(math_rad(math_random(-deg, deg)), math_rad(math_random(-deg, deg)), 0)
                                        else
                                            local assetBox = Instance.new("Frame")
                                            assetBox.BackgroundColor3 = Color3.new(0, 0, 0)
                                            assetBox.BackgroundTransparency = 0
                                            assetBox.BorderSizePixel = 0
                                            assetBox.Visible = false
                                            assetBox.Parent = screenGui
                                            corruptedObjects[p].box = assetBox
                                            corruptedObjects[p].baseSize = math_max(p.Size.X, p.Size.Y, p.Size.Z) * 1.5
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            -- Ambient music playing without Multi present: slower candidate check (45 studs around player)
            for _, p in ipairs(Workspace:GetDescendants()) do
                if p:IsA("BasePart") and p.Anchored and not corruptedObjects[p] and not isTargetPart(p) and not isWallFloorOrTerrain(p) then
                    if not (char and p:IsDescendantOf(char)) then
                        if (p.Position - playerPos).Magnitude <= 45 then
                            if math_random() <= 0.5 then
                                corruptedObjects[p] = {cf = p.CFrame, box = nil}
                                local outcome = (math_random() <= 0.5) and 1 or 2

                                if outcome == 1 then
                                    local deg = 15
                                    p.CFrame = p.CFrame * CFrame.Angles(math_rad(math_random(-deg, deg)), math_rad(math_random(-deg, deg)), 0)
                                else
                                    local assetBox = Instance.new("Frame")
                                    assetBox.BackgroundColor3 = Color3.new(0, 0, 0)
                                    assetBox.BackgroundTransparency = 0
                                    assetBox.BorderSizePixel = 0
                                    assetBox.Visible = false
                                    assetBox.Parent = screenGui
                                    corruptedObjects[p].box = assetBox
                                    corruptedObjects[p].baseSize = math_max(p.Size.X, p.Size.Y, p.Size.Z) * 1.5
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function restoreCorruptedObjects()
    for part, data in pairs(corruptedObjects) do
        if part and part.Parent then pcall(function() part.CFrame = data.cf end) end
        if data.box then pcall(function() data.box:Destroy() end) end
    end
    corruptedObjects = {}
end

task.spawn(function()
    task.wait(1)
    local lastCorruptTime = 0

    while true do
        pcall(function()
            trackedTargetParts = {}
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("BasePart") and isTargetPart(desc) then
                    table_insert(trackedTargetParts, desc)
                end
            end

            handleDialogueSystem()

            local hasMulti = (#trackedTargetParts > 0)
            local audioActive = isAnyAmbientPlaying()

            if hasMulti or audioActive then
                local now = os_clock()
                local minMultiDist = math.huge
                if hasMulti then
                    local char = player.Character
                    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                    local pPos = root and root.Position or camera.CFrame.Position
                    for _, mp in ipairs(trackedTargetParts) do
                        if mp and mp.Parent then
                            local d = (mp.Position - pPos).Magnitude
                            if d < minMultiDist then minMultiDist = d end
                        end
                    end
                end

                if hasMulti and minMultiDist <= 45 then
                    -- Normal smooth interval when Multi is active nearby
                    if now - lastCorruptTime >= 1.2 then
                        lastCorruptTime = now
                        corruptObjectsInRange("MultiProximity")
                    end
                elseif audioActive then
                    -- Much slower interval when only background music is playing (preventing chaos/lag)
                    if now - lastCorruptTime >= 6.0 then
                        lastCorruptTime = now
                        corruptObjectsInRange("AmbientSlow")
                    end
                end
            else
                if next(corruptedObjects) ~= nil then
                    restoreCorruptedObjects()
                end
            end
        end)
        task.wait(0.2)
    end
end)

local lineColors = {Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255), Color3.fromRGB(170, 0, 255)}
local boxColors = {Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 170, 255), Color3.fromRGB(255, 0, 120)}

local function spawnGlitchLine()
    local now = os_clock()
    for _, g in ipairs(glitchLines) do
        if now > g.expire then
            g.expire = now + 4.0
            local vp = camera.ViewportSize
            g.frame.Size = UDim2.new(0, vp.X, 0, 1)
            g.frame.Position = UDim2.new(0, 0, 0, math_random(20, math_max(30, vp.Y - 20)))
            g.frame.BackgroundColor3 = lineColors[math_random(1, #lineColors)]
            g.frame.BackgroundTransparency = 0.2
            g.frame.Visible = true
            task.delay(4.0, function() g.frame.Visible = false end)
            break
        end
    end
end

local function spawnGlitchBox()
    local now = os_clock()
    for _, b in ipairs(glitchBoxes) do
        if now >= b.expire then
            b.expire = now + 4.0
            local vp = camera.ViewportSize
            local bw, bh = math_random(150, 300), math_random(16, 28)
            b.frame.Size = UDim2.new(0, bw, 0, bh)
            b.frame.Position = UDim2.new(0, math_random(10, math_max(20, vp.X - bw - 10)), 0, math_random(10, math_max(20, vp.Y - bh - 10)))
            b.top.BackgroundColor3 = boxColors[math_random(1, #boxColors)]
            b.bottom.BackgroundColor3 = boxColors[math_random(1, #boxColors)]
            b.frame.Visible = true
            task.delay(4.0, function() b.frame.Visible = false end)
            break
        end
    end
end

local lastSpawnTick = 0

RunService.RenderStepped:Connect(function()
    if not screenGui or not screenGui.Parent then return end

    local origin = camera.CFrame.Position

    for part, data in pairs(corruptedObjects) do
        if data.box and part and part.Parent then
            local pt, onScreen = camera:WorldToViewportPoint(part.Position)
            local dist = (origin - part.Position).Magnitude
            if onScreen and pt.Z > 0 and dist < 300 and isVisibleFromCamera(part.Position, part) then
                local sz = math_clamp(350 / math_max(1, dist) * (data.baseSize or 2), 15, 350)
                data.box.Size = UDim2.new(0, sz, 0, sz)
                data.box.Position = UDim2.new(0, pt.X - sz/2, 0, pt.Y - sz/2)
                data.box.Visible = true
            else
                data.box.Visible = false
            end
        end
    end

    local bestPart = nil
    local bestPt = Vector3.zero
    local bestDist = math.huge
    local looking = false

    for _, part in ipairs(trackedTargetParts) do
        if part and part.Parent then
            local pos = part.Position
            local dist = (origin - pos).Magnitude
            local pt, onScreen = camera:WorldToViewportPoint(pos)
            if onScreen and pt.Z > 0 and isVisibleFromCamera(pos, part) then
                looking = true
                if dist < bestDist then
                    bestDist = dist
                    bestPart = part
                    bestPt = pt
                end
            end
        end
    end

    local now = os_clock()
    if bestPart and bestPt ~= Vector3.zero and looking then
        local mainSize = math_clamp(3800 / bestDist, 45, 160)
        mainBox.Size = UDim2.new(0, mainSize, 0, mainSize)
        mainBox.Position = UDim2.new(0, bestPt.X - mainSize/2, 0, bestPt.Y - mainSize/2)
        mainBox.Visible = true

        for _, sq in ipairs(rapidBoxes) do
            if now >= sq.nextTick then
                sq.nextTick = now + 0.1
                if math_random() <= 0.3 then
                    local offset = math_random(20, math_floor(mainSize * 0.7))
                    local angle = math_random() * 6.28
                    sq.frame.Position = UDim2.new(0, bestPt.X + math_cos(angle)*offset - 7, 0, bestPt.Y + math_sin(angle)*offset - 7)
                    sq.frame.Visible = true
                    task.delay(0.15, function() sq.frame.Visible = false end)
                end
            end
        end
    else
        mainBox.Visible = false
    end

    local hasMulti = (#trackedTargetParts > 0)
    local audioActive = isAnyAmbientPlaying()

    if hasMulti or audioActive then
        local interval = 0.6
        local chance = 0.5

        if bestPart then
            local isClose = (bestDist <= 45)
            local isLookingAtIt = looking

            if isClose and isLookingAtIt then
                interval = 0.15
                chance = 0.85
            elseif isClose or isLookingAtIt then
                interval = 0.6
                chance = 0.5
            else
                interval = 1.4
                chance = 0.25
            end
        else
            interval = 1.4
            chance = 0.25
        end

        if now - lastSpawnTick > interval then
            lastSpawnTick = now
            if math_random() <= chance then spawnGlitchLine() end
            if math_random() <= chance then spawnGlitchBox() end
        end
    end
end)

local isDead = false

local function triggerDeathSequence()
    if isDead then return end
    isDead = true

    pcall(function()
        dialogueLabel.Visible = false
        mainBox.Size = UDim2.new(1, 0, 1, 0)
        mainBox.Position = UDim2.new(0, 0, 0, 0)
        mainBox.BackgroundColor3 = Color3.fromRGB(15, 0, 0)
        mainBox.Visible = true

        task.wait(0.5)
        showDialogue("i remember you, expandable", 3)
        task.wait(3.5)
        showDialogue("remember me?", 3)
        task.delay(3.5, function()
            dialogueLabel.Visible = false
            mainBox.Visible = false
            isDead = false
        end)
    end)
end

local function monitorCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.Died:Connect(function()
            triggerDeathSequence()
        end)
    end
end

