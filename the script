genv.MultiRedactRunning = function()
    if activeConnection then activeConnection:Disconnect() end
    if activeScanner then task.cancel(activeScanner) end
    pcall(function() screenGui:Destroy() end)
    for _, boxEntry in ipairs(activeAssetBoxes) do
        pcall(function() boxEntry.frame:Destroy() end)
    end
    genv.MultiRedactRunning = nil
end
